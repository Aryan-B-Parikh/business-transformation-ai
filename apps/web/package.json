{
  "name": "@bta/web",
  "version": "0.1.0",
  "private": true,
  "description": "Web frontend — React + TypeScript (see 02_TECHNICAL_ARCHITECTURE.md §7)",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
