{
  "name": "@bta/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Expo native mobile client for Business Transformation AI",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
