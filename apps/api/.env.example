# Copy to .env and fill in
DATABASE_URL="postgresql://bta_app:changeme@localhost:5432/bta?schema=public"
# For RLS tests, the app connects as bta_app (non-superuser) so policies are enforced.
# Superuser (postgres) bypasses RLS — never use for app queries.
DIRECT_URL="postgresql://postgres:changeme@localhost:5432/bta?schema=public"
