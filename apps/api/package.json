{
  "name": "@bta/api",
  "version": "0.1.0",
  "private": true,
  "description": "Core API service — workspaces, projects, auth, RBAC (see 02_TECHNICAL_ARCHITECTURE.md §2.1)",
  "main": "dist/index.js",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "test": "vitest run --coverage=false",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:studio": "prisma studio",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1121.0",
    "@aws-sdk/s3-request-presigner": "^3.1121.0",
    "@bta/shared": "*",
    "@prisma/client": "^5.14.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "docx": "^9.2.0",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jszip": "^3.10.1",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.10.0",
    "multer": "^2.3.0",
    "pdf-parse": "^1.1.1",
    "pdfkit": "^0.16.0",
    "pg": "^8.11.3",
    "pptxgenjs": "^3.12.0",
    "uuid": "^14.0.2",
    "zod": "^4.5.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.11.0",
    "@types/pdfkit": "^0.13.9",
    "@types/pg": "^8.10.9",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^11.0.0",
    "prisma": "^5.14.0",
    "rimraf": "^5.0.5",
    "supertest": "^7.2.2",
    "typescript": "^5.3.3",
    "vitest": "^1.4.0"
  }
}
